<?xml version="1.0" encoding="utf-8"?>
<!-- One Today row on the home-screen widget: the circle checks it off, the title opens it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
    <TextView android:id="@+id/row_check" style="@style/WidgetRow" android:layout_width="wrap_content"
        android:paddingEnd="12dp" android:text="○" android:contentDescription="Mark done" />
    <TextView android:id="@+id/row_title" style="@style/WidgetRow" android:layout_width="0dp" android:layout_weight="1" />
</LinearLayout>
