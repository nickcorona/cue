{
  "rewrites": [
    {
      "source": "/mcp/:key",
      "destination": "/api/mcp?key=:key"
    },
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/push",
      "destination": "/api/push"
    },
    {
      "source": "/.well-known/oauth-protected-resource/:path*",
      "destination": "/api/oauth?route=resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/oauth?route=resource"
    },
    {
      "source": "/.well-known/oauth-authorization-server/:path*",
      "destination": "/api/oauth?route=server"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/oauth?route=server"
    },
    {
      "source": "/.well-known/openid-configuration",
      "destination": "/api/oauth?route=server"
    },
    {
      "source": "/oauth/:route",
      "destination": "/api/oauth?route=:route"
    },
    {
      "source": "/app/:key",
      "destination": "/api/web?key=:key"
    },
    {
      "source": "/",
      "destination": "/api/web"
    },
    {
      "source": "/w",
      "destination": "/api/web?view=widget"
    },
    {
      "source": "/manifest.webmanifest",
      "destination": "/api/web?asset=manifest"
    },
    {
      "source": "/sw.js",
      "destination": "/api/web?asset=sw"
    }
  ],
  "functions": {
    "api/push-fire.js": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "cue-push"
        }
      ]
    }
  }
}
